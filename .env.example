# Harbor Satellite
# Copy this file to .env. Both cmd/groundcontrol and cmd/satellite read .env.

# Ground Control registration.
# TOKEN is required unless SPIFFE_ENABLED=true.
GROUND_CONTROL_URL=http://127.0.0.1:8080
TOKEN=

# TLS/SPIFFE registration.
USE_UNSECURE=false
SPIFFE_ENABLED=false
SPIFFE_ENDPOINT_SOCKET=unix:///run/spire/sockets/agent.sock
SPIFFE_EXPECTED_SERVER_ID=

# Local/external registry configuration.
BYO_REGISTRY=false
REGISTRY_URL=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_DATA_DIR=

# Local config and shutdown behavior.
CONFIG_DIR=
SHUTDOWN_TIMEOUT=30s

# CRI registry fallback and Harbor registry override.
NO_REGISTRY_FALLBACK=false
HARBOR_REGISTRY_URL=

# Satellite-owned OCI proxy. Modes: proxy (fill misses) or replica (local only).
PROXY_MODE=proxy
PROXY_PORT=8585
# Harbor 3 skeleton, parsed but not used yet (ADR-0013): connection cap and
# per-write deadline (0 disables), streaming pull-through and its prefetch lane.
PROXY_MAX_CONNECTIONS=0
PROXY_WRITE_TIMEOUT=0s
PROXY_STREAMING=false
PROXY_PREFETCH_CONCURRENCY=2

# Experimental direct delivery.
DIRECT_DELIVERY=false
IMAGE_DIR=

# Harbor 3 skeleton, parsed but not used yet: address for /healthz and /metrics.
TELEMETRY_ADDR=


# Ground Control

# Harbor source registry.
HARBOR_URL=
HARBOR_USERNAME=
HARBOR_PASSWORD=

# Robot account expiry in days. Invalid, zero, and negative values fall back to 30.
ROBOT_DURATION_DAYS=30

# WARNING: TESTING/DEVELOPMENT ONLY - DO NOT USE IN PRODUCTION.
# Skips Harbor health checks and uses placeholder credentials/state in SPIFFE flows.
SKIP_HARBOR_HEALTH_CHECK=false

# Harbor 3 skeleton, parsed but not used yet (plan item 2).
# Requests per second the async plane sends to Harbor.
HARBOR_RATE_LIMIT=20
# How often Ground Control pings Harbor to report it as degraded in /health.
HARBOR_PROBE_INTERVAL=30s
# Outbox publisher: claim size, polling, handlers per worker, retries with
# exponential backoff, and how long a claimed event stays leased.
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=1s
OUTBOX_CONCURRENCY=4
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE=1s
OUTBOX_BACKOFF_MAX=5m
OUTBOX_LEASE=1m

# HTTP server and initial system admin.
PORT=8080
ADMIN_PASSWORD=

# User authentication policy.
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=false
SESSION_DURATION=24h
LOCKOUT_DURATION=5m
# Failed authentication attempts (login and Basic auth, any username) per client IP
# within the window before 429 (plan item D6, not enforced yet).
AUTH_FAILURE_LIMIT=20
AUTH_FAILURE_WINDOW=1m

# How long a satellite without an @every heartbeat interval may stay silent
# before it is stale (plan item 4.3, not read yet).
STALE_THRESHOLD=15m

# Fleet hot path (plan item 4, ADR-0016). Parsed but not used yet, except
# that RATE_LIMIT_SPLIT=true builds the split limiters, which answer 501
# until plan item 4.6: leave it off.
SATELLITE_SESSION_TTL=720h
# At most 5m: bounds how long a revocation takes to reach other replicas.
SATELLITE_SESSION_CACHE_TTL=30s
SATELLITE_SESSION_CACHE_SIZE=10000
SATELLITE_ROBOT_AUTH=true
HEARTBEAT_FLUSH_INTERVAL=5s
HEARTBEAT_BUFFER_MAX=10000
HEARTBEAT_MAX_FLUSH_FAILURES=3
STALE_CHECK_INTERVAL=1m
SESSION_EXPIRY_INTERVAL=1h
STATUS_RETENTION_DAYS=7
STATUS_PARTITIONS_AHEAD=3
RATE_LIMIT_SPLIT=false
RATE_LIMIT_ANONYMOUS=10/1m
RATE_LIMIT_FLEET=3/1s

# Largest heartbeat body POST /satellites/sync accepts, journal included;
# larger ones get 413 (plan item 6.5, not enforced yet).
SYNC_MAX_BODY_BYTES=4194304

# /api authorization (plan item 7, ADR-0017): builtin is today's
# system_admin check; casbin uses the stored policy, polled every interval.
POLICY_ENGINE=builtin
POLICY_POLL_INTERVAL=10s

# PostgreSQL.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Harbor 3 skeleton, parsed but not used yet (plan items 3.2 and 3.3).
# TLS to PostgreSQL; the default sslmode stays disable for now.
DB_SSLMODE=disable
DB_SSLROOTCERT=
# One URL per plane; fleet and async without a URL use the API pool, and the
# API pool uses DB_URL_API or the DB_* settings above.
DB_URL_API=
DB_URL_FLEET=
DB_URL_ASYNC=
# Pool settings per plane; empty keeps the database/sql default.
DB_API_MAX_OPEN_CONNS=
DB_API_MAX_IDLE_CONNS=
DB_API_CONN_MAX_LIFETIME=
DB_API_CONN_MAX_IDLE_TIME=
DB_API_STATEMENT_TIMEOUT=
DB_API_LOCK_TIMEOUT=
DB_API_IDLE_IN_TX_SESSION_TIMEOUT=
DB_FLEET_MAX_OPEN_CONNS=
DB_FLEET_MAX_IDLE_CONNS=
DB_FLEET_CONN_MAX_LIFETIME=
DB_FLEET_CONN_MAX_IDLE_TIME=
DB_FLEET_STATEMENT_TIMEOUT=
DB_FLEET_LOCK_TIMEOUT=
DB_FLEET_IDLE_IN_TX_SESSION_TIMEOUT=
DB_ASYNC_MAX_OPEN_CONNS=
DB_ASYNC_MAX_IDLE_CONNS=
DB_ASYNC_CONN_MAX_LIFETIME=
DB_ASYNC_CONN_MAX_IDLE_TIME=
DB_ASYNC_STATEMENT_TIMEOUT=
DB_ASYNC_LOCK_TIMEOUT=
DB_ASYNC_IDLE_IN_TX_SESSION_TIMEOUT=

# TLS configuration.
# If TLS_CERT_FILE and TLS_KEY_FILE are set, HTTPS is enabled.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Set TLS_CA_FILE to enable mutual TLS with client certificate verification.
TLS_CA_FILE=

# SPIFFE/SPIRE for Ground Control mTLS.
SPIFFE_SERVER_ENABLED=false
# SPIFFE_PROVIDER can be sidecar (SPIRE agent Workload API) or static
# (cert/key/bundle files).
SPIFFE_TRUST_DOMAIN=harbor-satellite.local
SPIFFE_PROVIDER=sidecar
SPIFFE_CERT_FILE=
SPIFFE_KEY_FILE=
SPIFFE_BUNDLE_FILE=

# Embedded SPIRE server. When enabled, Ground Control starts a local SPIRE
# server process and uses SPIRE_DATA_DIR/SPIRE_TRUST_DOMAIN/SPIRE_BIND_ADDRESS.
EMBEDDED_SPIRE_ENABLED=false
SPIRE_DATA_DIR=/tmp/spire-data
SPIRE_TRUST_DOMAIN=harbor-satellite.local
SPIRE_BIND_ADDRESS=127.0.0.1

# External SPIRE server. Used when EMBEDDED_SPIRE_ENABLED=false and
# SPIRE_SERVER_SOCKET is set. Address/port are returned to satellite
# registration clients as SPIRE agent bootstrap metadata.
SPIRE_SERVER_SOCKET=
SPIRE_SERVER_ADDRESS=spire-server
SPIRE_SERVER_PORT=8081

# Audit logging for security events.
# Set AUDIT_LOG_ENABLED=true to emit authentication, registration, user
# management, and policy events as RFC 5424 syslog messages and/or OTel logs.
# AUDIT_SYSLOG_ENABLED=true keeps the syslog transport on by default; set it to
# false to export only over OpenTelemetry (requires AUDIT_OTEL_ENDPOINT). When
# auditing is enabled, turning off both transports fails fast at startup.
# AUDIT_SYSLOG_TARGET selects the destination: daemon | network | file.
#   daemon  -> local syslog daemon at AUDIT_SYSLOG_SOCKET_PATH
#   network -> remote SIEM at AUDIT_SYSLOG_ADDRESS over AUDIT_SYSLOG_NETWORK
#   file    -> rotated local file at AUDIT_SYSLOG_FILE_PATH
# When AUDIT_TRUST_FORWARDED_HEADERS=true, source_ip is taken from
# X-Forwarded-For / X-Real-IP. Leave false unless GC sits behind a trusted
# reverse proxy; otherwise clients can spoof the audit source IP.
AUDIT_LOG_ENABLED=false
AUDIT_SYSLOG_ENABLED=true
AUDIT_SYSLOG_TARGET=file
AUDIT_SYSLOG_TAG=harbor-audit
AUDIT_SYSLOG_SOCKET_PATH=/dev/log
AUDIT_SYSLOG_NETWORK=udp
AUDIT_SYSLOG_ADDRESS=
AUDIT_SYSLOG_FILE_PATH=./audit.log
AUDIT_SYSLOG_FILE_MAX_SIZE_MB=100
AUDIT_SYSLOG_FILE_MAX_BACKUPS=7
AUDIT_SYSLOG_FILE_MAX_AGE_DAYS=30
AUDIT_SYSLOG_FILE_COMPRESS=true

# OTLP/HTTP collector base URL, for example http://127.0.0.1:4318.
# Empty disables the OTel transport.
AUDIT_OTEL_ENDPOINT=
AUDIT_TRUST_FORWARDED_HEADERS=false
