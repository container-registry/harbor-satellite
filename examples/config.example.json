{
  "state_config": {
    "auth": {
      "url": "https://harbor.example.com",
      "username": "robot$satellite",
      "password": "replace-with-robot-account-token"
    },
    "state": "https://harbor.example.com/satellite/satellite-state/example-satellite/state:latest"
  },
  "app_config": {
    "ground_control_url": "",
    "log_level": "info",
    "use_unsecure": true,
    "state_replication_interval": "@every 00h00m10s",
    "register_satellite_interval": "@every 00h00m10s",
    "heartbeat_interval": "@every 00h00m30s",
    "metrics": {
      "collect_cpu": true,
      "collect_memory": true,
      "collect_storage": true
    },
    "tls": {
      "cert_file": "",
      "key_file": "",
      "ca_file": "",
      "skip_verify": false
    },
    "encrypt_config": false,
    "registry_fallback": {
      "enabled": false,
      "registries": ["docker.io"],
      "runtimes": []
    },
    "audit": {
      "enabled": false,
      "syslog": {
        "target": "file",
        "tag": "harbor-audit",
        "socket_path": "/dev/log",
        "network": "udp",
        "address": "",
        "file": {
          "path": "./audit.log",
          "max_size_mb": 100,
          "max_backups": 7,
          "max_age_days": 30,
          "compress": true
        }
      },
      "otel": {
        "enabled": false,
        "endpoint": ""
      }
    }
  }
}
