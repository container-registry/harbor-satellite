# Harbor Satellite environment for the systemd unit.
# Install as /etc/harbor-satellite/satellite.env (mode 0600, owned by root).
# Every variable here also has a command line flag, see "satellite -help".

# Ground Control URL.
GROUND_CONTROL_URL=https://ground-control.example.com:8080

# Harbor registry the satellite pulls from. Overrides the Harbor host in
# the credentials and state URLs that Ground Control hands out.
HARBOR_REGISTRY_URL=https://harbor.example.com

# Registration token from Ground Control. It is single use and expires
# after 24 hours. Leave it out when SPIFFE is enabled (see spiffe.env.example).
TOKEN=your-satellite-token-here

# Use plain HTTP and skip TLS verification. Testing only.
# USE_UNSECURE=false

# Local OCI proxy on 127.0.0.1. "proxy" fills misses from Harbor,
# "replica" serves only content that was already replicated.
# PROXY_MODE=proxy
# PROXY_PORT=8585

# How long the satellite waits for in-flight work on shutdown. Keep it below
# TimeoutStopSec in the unit (45s).
# SHUTDOWN_TIMEOUT=30s

# The unit sets CONFIG_DIR to /var/lib/harbor-satellite. Replicated images go
# to $CONFIG_DIR/oci. To store them elsewhere set REGISTRY_DATA_DIR and add
# that path to ReadWritePaths= in a drop-in, or the sandbox blocks writes.
# REGISTRY_DATA_DIR=/srv/harbor-satellite/oci

# Replicate into an existing registry instead of the local OCI layout.
# BYO_REGISTRY=false
# REGISTRY_URL=http://127.0.0.1:5000
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=

# Container runtime mirroring has no environment variable. Use the
# 20-cri-mirroring.conf drop-in together with one of
# 30-mirrors-containerd.conf, 30-mirrors-docker.conf or 30-mirrors-podman.conf,
# which override ExecStart with a --mirrors flag.
