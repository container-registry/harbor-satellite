# Harbor Satellite environment for SPIFFE authentication.
# Install as /etc/harbor-satellite/satellite.env (mode 0600, owned by root)
# together with the 10-spire-dependency.conf drop-in.
#
# The satellite side is the same for join token, x509pop and sshpop
# attestation. The method is configured in the SPIRE agent, see
# examples/deploy/spiffe/ in this repository.

GROUND_CONTROL_URL=https://ground-control.example.com:8080
HARBOR_REGISTRY_URL=https://harbor.example.com

SPIFFE_ENABLED=true
SPIFFE_ENDPOINT_SOCKET=unix:///run/spire/sockets/agent.sock

# SPIFFE ID that Ground Control presents.
SPIFFE_EXPECTED_SERVER_ID=spiffe://harbor-satellite.local/ground-control

# The proxy and storage settings from satellite.env.example apply here too.
